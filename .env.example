# ========================================
# Charles Jasema Portfolio - Environment Variables
# Complete list of all environment variables for deployment
# ========================================

# ========================================
# CORE CONFIGURATION (REQUIRED FOR BASIC DEPLOYMENT)
# ========================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://charlesjasema.com
NEXT_PUBLIC_SITE_NAME=Charles Jasema Portfolio
NEXT_PUBLIC_SITE_DESCRIPTION=Professional portfolio of Charles Jasema - Software Engineer, Designer & Gospel Artist
NODE_ENV=production

# Sanity CMS Configuration (Required for content management)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token
SANITY_REVALIDATION_SECRET=your-revalidation-secret

# ========================================
# CONTACT & COMMUNICATION
# ========================================

# Contact Configuration
CONTACT_EMAIL=brocharles001@gmail.com
FROM_EMAIL=noreply@charlesjasema.com
FROM_NAME=Charles Jasema
REPLY_TO_EMAIL=contact@charlesjasema.com

# Email Service Settings
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=1000
EMAIL_TIMEOUT=30000

# SendGrid Email Provider (Primary - Priority 1)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@charlesjasema.com

# Resend Email Provider (Secondary - Priority 2)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@charlesjasema.com

# AWS SES Email Provider (Tertiary - Priority 3)
AWS_SES_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SES_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@charlesjasema.com

# WhatsApp Business API Configuration
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret

# WhatsApp Public Display Numbers
NEXT_PUBLIC_WHATSAPP_PHONE=+256785446877
NEXT_PUBLIC_WHATSAPP_DISPLAY_PHONE=+256 785 446 877

# ========================================
# AI & CHAT FEATURES
# ========================================

# AI Chat Configuration
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_MAX_MESSAGES=20

# ========================================
# NEWSLETTER & EMAIL MARKETING
# ========================================

# Newsletter Configuration
NEWSLETTER_AUDIENCE_ID=your-sendgrid-audience-id
NEWSLETTER_TEMPLATE_ID=your-email-template-id

# Mailchimp Integration
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_LIST_ID=your-mailchimp-list-id

# ========================================
# CLOUD STORAGE & FILE MANAGEMENT
# ========================================

# Google Drive Integration
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-shared-folder-id

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET_NAME=charles-jasema-downloads
CLOUDFLARE_R2_PUBLIC_URL=https://downloads.charlesjasema.com

# ========================================
# SECURITY & AUTHENTICATION
# ========================================

# Security Configuration (32+ character random strings)
CSRF_SECRET=your-csrf-secret-key-32-characters-minimum
RATE_LIMIT_SECRET=your-rate-limit-secret-32-characters-minimum

# Recruiter Mode Authentication
RECRUITER_ACCESS_PASSWORD=your-secure-recruiter-password
RECRUITER_SESSION_SECRET=your-session-secret-key-32-characters-minimum
RECRUITER_SESSION_DURATION=86400000

# JWT Configuration (if used)
JWT_SECRET=your-jwt-secret-key-32-characters-minimum

# ========================================
# ANALYTICS & TRACKING
# ========================================

# Google Analytics Configuration
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Analytics (if using)
VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# ========================================
# THIRD-PARTY INTEGRATIONS
# ========================================

# Tawk.to Live Chat Configuration
NEXT_PUBLIC_TAWK_TO_PROPERTY_ID=your-tawk-property-id
NEXT_PUBLIC_TAWK_TO_WIDGET_ID=your-tawk-widget-id

# Social Media URLs (Public)
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/charlesjasema
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/charlesjasema
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/charlesjasema
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/charlesjasema
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@charlesjasema
NEXT_PUBLIC_GITHUB_URL=https://github.com/charlesjasema

# ========================================
# DEVELOPMENT & DEBUGGING
# ========================================

# Bundle Analyzer (Development Only)
ANALYZE=false

# Legacy SMTP Configuration (Deprecated - Use Email Providers Above)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ========================================
# ENVIRONMENT VARIABLE CATEGORIES:
# 
# REQUIRED FOR BASIC DEPLOYMENT:
# - NEXT_PUBLIC_SITE_URL
# - NODE_ENV
# - NEXT_PUBLIC_SANITY_PROJECT_ID (if using CMS)
# - NEXT_PUBLIC_SANITY_DATASET (if using CMS)
#
# REQUIRED FOR CONTACT FUNCTIONALITY:
# - CONTACT_EMAIL
# - SENDGRID_API_KEY (or alternative email provider)
# - FROM_EMAIL
#
# REQUIRED FOR SECURITY:
# - CSRF_SECRET
# - RATE_LIMIT_SECRET
#
# OPTIONAL FOR ENHANCED FEATURES:
# - AI Chat: OPENAI_API_KEY, ANTHROPIC_API_KEY
# - WhatsApp: WHATSAPP_* variables
# - Analytics: NEXT_PUBLIC_GA_ID
# - File Downloads: Google Drive or Cloudflare R2 variables
# - Recruiter Mode: RECRUITER_* variables
# - Newsletter: MAILCHIMP_* variables
# ========================================